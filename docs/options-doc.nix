# Renders every `smol.*` option to Markdown (BRIEFING §5, `just docs`).
{
  pkgs,
  lib,
  smolModule,
}:
let
  eval = lib.evalModules {
    modules = [
      smolModule
      { _module.check = false; }
    ];
    specialArgs = {
      inherit pkgs;
      config = { };
    };
  };

  filtered = lib.filterAttrs (name: _: name == "smol") eval.options;

  repo = "https://github.com/wearetechnative/smol-nixos-base-image-nivis-ec2-experiment";

  # Rewrite /nix/store/<hash>-source/... to a repo-relative path, so the
  # generated file does not change every time the store hash changes.
  relative =
    decl:
    let
      parts = lib.splitString "/" (toString decl);
      rel = lib.concatStringsSep "/" (lib.drop 4 parts);
    in
    if lib.hasPrefix "/nix/store/" (toString decl) then
      {
        name = rel;
        url = "${repo}/blob/main/${rel}";
      }
    else
      decl;

  doc = pkgs.nixosOptionsDoc {
    options = filtered;
    warningsAreErrors = false;
    transformOptions = opt: opt // { declarations = map relative opt.declarations; };
  };
in
pkgs.runCommand "smol-options.md" { } ''
  {
    echo "# smol.* options"
    echo
    echo "Generated by \`just docs\`. Do not edit by hand."
    echo
    cat ${doc.optionsCommonMark}
  } > $out
''
