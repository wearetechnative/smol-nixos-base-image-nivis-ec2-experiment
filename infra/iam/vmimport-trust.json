{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VMImportServiceMayAssumeThisRole",
      "Effect": "Allow",
      "Principal": {
        "Service": "vmie.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "vmimport"
        }
      }
    }
  ]
}
