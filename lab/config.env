# Non-secret lab settings (BRIEFING §7). This file is committed on purpose:
# it holds no credentials and the whole lab reads its region and tags from it.
# The access key lives only in ~/.aws/credentials under [smol-lab-base].

# The playground account. Not a secret: the role ARN has to be known to assume
# it. The lab refuses to run against any other account.
AWS_ACCOUNT_ID=076504012268

# The region the lab is locked to. The IAM policy denies everything outside it.
AWS_REGION=eu-central-1

# The profile that assumes SmolLabRole. Defined in ~/.aws/config.
AWS_PROFILE=smol-lab

# Instance type for gate 2. Must be one of the types allowed by
# infra/iam/SmolLabRole-permissions.json: t3.micro or t3.small.
SMOL_INSTANCE_TYPE=t3.micro

# Every resource the lab creates carries Project=<this> and Experiment=<id>.
SMOL_PROJECT_TAG=smol-lab

# Minutes after which `just reap` terminates a tagged resource.
SMOL_REAP_AFTER_MINUTES=60

# Pause and ask Pim past this many EC2 hours in one session (BRIEFING §9).
SMOL_MAX_EC2_HOURS=4

# Budget alert, read by infra/iam/bootstrap.sh. AWS Budgets only accepts the
# account's billing currency, and the playground account bills in USD, so 55
# USD stands in for the agreed 50 EUR. Set SMOL_BUDGET_EMAIL before running
# bootstrap.sh to get an alert at 80 percent.
SMOL_BUDGET_AMOUNT=55
SMOL_BUDGET_UNIT=USD
