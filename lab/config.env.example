# Copy to lab/config.env and fill in. NEVER put a key, secret or session token
# in this file (BRIEFING §7). It holds only non-secret lab settings.

# AWS region the lab is locked to.
AWS_REGION=

# The profile that assumes SmolLabRole. The key itself lives only in
# ~/.aws/credentials under [smol-lab-base].
AWS_PROFILE=smol-lab

# Instance type used for gate 2.
SMOL_INSTANCE_TYPE=t3.micro

# Every resource the lab creates carries these tags.
SMOL_PROJECT_TAG=smol-lab

# Minutes after which `just reap` terminates a tagged resource.
SMOL_REAP_AFTER_MINUTES=60

# Wall-clock budget guard: pause and ask Pim past this many EC2 hours
# in one session (BRIEFING §9).
SMOL_MAX_EC2_HOURS=4
